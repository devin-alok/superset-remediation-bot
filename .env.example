# Repository whose issues get remediated
GITHUB_REPO=devin-alok/superset
# Token with permission to read issues and post comments on GITHUB_REPO
GITHUB_TOKEN=ghp_xxx
# Devin: Settings -> Service Users (org ID + a service-user API key with UseDevinSessions)
DEVIN_ORG_ID=org-xxx
DEVIN_API_KEY=xxx
# Optional: poll interval, minutes per session, sessions per issue, issues in flight at once
# POLL_SECONDS=60
# SESSION_TIMEOUT_MINUTES=25
# MAX_ATTEMPTS=3
# MAX_CONCURRENT=5
