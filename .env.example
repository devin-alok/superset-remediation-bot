# Target repository (the Superset fork whose issues get remediated)
GITHUB_REPO=devin-alok/superset
GITHUB_TOKEN=ghp_xxx                 # repo scope: read issues, comment, label
GITHUB_WEBHOOK_SECRET=change-me      # must match the GitHub webhook secret

# Devin API — https://app.devin.ai/settings/api-keys
DEVIN_API_KEY=apk_xxx
# Set only for org-scoped v3 keys; leave empty to use v1.
DEVIN_ORG_ID=

# Behaviour
TRIGGER_LABEL=devin:remediate
TRACKER_ISSUE=10
MAX_ACU_PER_SESSION=5
MAX_CONCURRENT_SESSIONS=3
MAX_NUDGES=2
POLL_INTERVAL_SECONDS=30
SESSION_TIMEOUT_SECONDS=5400

# 1 = replay fixtures, never call Devin or GitHub, never spend ACUs
DRY_RUN=0
STATE_DIR=runs
